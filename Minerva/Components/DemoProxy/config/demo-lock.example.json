{
  "formatVersion": 1,
  "rules": {
    "logging": {
      "logRequestBodies": false,
      "logResponseBodies": false,
      "redactHeaders": [
        "authorization",
        "cookie",
        "ocp-apim-subscription-key",
        "set-cookie",
        "x-api-key"
      ]
    },
    "matching": {
      "requiredRequestHeaders": {
        "origin": "^https://demo-ui.example.com$"
      }
    },
    "platform": {
      "healthPort": 8081,
      "pacPort": 8765
    },
    "proxy": {
      "failOpen": true,
      "listenHost": "127.0.0.1",
      "listenPort": 8080,
      "maxBufferBytes": 10485760
    },
    "target": {
      "host": "api.demo.example.com",
      "methods": [
        "POST"
      ],
      "paths": [
        "^/api/chatbot/ask$"
      ],
      "port": 443,
      "requestContentTypes": [
        "application/json"
      ],
      "responseContentTypes": [
        "application/json"
      ],
      "scheme": "https"
    },
    "transformation": {
      "enabled": true,
      "mode": "deterministic",
      "preserveUnknownFields": true,
      "transformerVersion": "1.3.0"
    }
  },
  "rulesSha256": "575d760e8e5493d25b83199f44faa069c73a40b1629a885c45453296d3dafbb7"
}
