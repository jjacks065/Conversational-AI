{"id":"sh/547294r6","kind":"textbox","name":"Title 1","position":{"left":82.77,"top":72.46,"width":1109.23,"height":57.02},"text":"COMPASS – CSR Chat","style":{"fontSize":40,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}},
{"id":"sh/7qp4be9c","kind":"textbox","name":"Content Placeholder 6","position":{"left":81.44,"top":662.77,"width":794.13,"height":29.08},"text":"CSR Chat  /  Jason Jackson  /  October 23, 2026  /  v2","style":{"fontSize":16,"typeface":"Geist Light","color":"#436DB3","alignment":"left"}},
{"id":"sh/65g3298r","kind":"textbox","name":"pitch-label","position":{"left":98,"top":170,"width":1080,"height":26},"text":"Product Overview","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ts7md4r2","kind":"textbox","name":"pitch","position":{"left":98,"top":204,"width":1090,"height":68},"text":"CSR Chat helps health plan service teams answer benefit questions faster with structured, plan-specific guidance grounded in approved benefit data.","style":{"fontSize":26.67,"typeface":"Geist Light","color":"#1D224B","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/sryl4zqx","kind":"textbox","name":"customer-heading","position":{"left":98,"top":286,"width":506,"height":28},"text":"The customer and problem","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/fu94fe98","kind":"textbox","name":"customer-body","position":{"left":98,"top":320,"width":506,"height":80},"text":"Health plan CSRs navigate complex plan data during live calls. Manual lookup increases handling time and the risk of inconsistent benefit explanations.","style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/utg3698n","kind":"textbox","name":"solution-heading","position":{"left":674,"top":286,"width":506,"height":28},"text":"The solution","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/wn6dc7eh","kind":"textbox","name":"solution-body","position":{"left":674,"top":320,"width":506,"height":80},"text":"Ask in plain language. CSR Chat returns coverage, cost sharing, limits and required disclosures from approved plan data for representative review.","style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/hofulsf2","kind":"textbox","name":"value-heading","position":{"left":98,"top":416,"width":506,"height":28},"text":"The value proposition","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ul4vaxgb","kind":"textbox","name":"value-body","position":{"left":98,"top":450,"width":506,"height":80},"text":"BSC, Sep 2026: 11 sec median answer time.\n32,114 interactions. 1,336 monthly active users.\nGoal: less manual benefit research during calls.","style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/5sfepcfe","kind":"textbox","name":"offer-heading","position":{"left":98,"top":554,"width":1080,"height":28},"text":"The offer and next step","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ipovexwn","kind":"textbox","name":"offer-body","position":{"left":98,"top":588,"width":1080,"height":60},"text":"Core in production at BSC. Standalone non-PHI pilots in pipeline. Next: Expand LOB and knowledge capabilities to serve the members wholly. Targets: ≥95% approved-case pass rate and launch 2 new pilot customers early in 2027.","style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/3qxwn2x8","kind":"textbox","name":"solution-heading","position":{"left":674,"top":418.77,"width":506,"height":28},"text":"Competitors","style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/sfqdkrep","kind":"textbox","name":"solution-body","position":{"left":674,"top":452.77,"width":506,"height":80},"text":"NiCE CXone Copilot and Genesys Agent Copilot.\nCSR Chat focus: health plan benefit interpretation,\napproved disclosures and representative review.","style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0}
]}
