{"kind":"textbox","id":"sh/7qp4be9c","slideIndex":0,"position":{"left":81.44,"top":662.77,"width":794.13,"height":29.08},"name":"Content Placeholder 6","text":"CSR Chat  /  Jason Jackson  /  October 23, 2026  /  v2","style":{"fontSize":16,"typeface":"Geist Light","color":"#436DB3","alignment":"left"}}
{"kind":"textbox","id":"sh/65g3298r","slideIndex":0,"position":{"left":98,"top":170,"width":1080,"height":26},"name":"pitch-label","text":"Product Overview","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/ts7md4r2","slideIndex":0,"position":{"left":98,"top":204,"width":1090,"height":68},"name":"pitch","text":"CSR Chat helps health plan service teams answer benefit questions faster with structured, plan-specific guidance grounded in approved benefit data.","geometry":"rect","lineWidth":0,"style":{"fontSize":26.67,"typeface":"Geist Light","color":"#1D224B","alignment":"left"}}
{"kind":"textbox","id":"sh/sryl4zqx","slideIndex":0,"position":{"left":98,"top":286,"width":506,"height":28},"name":"customer-heading","text":"The customer and problem","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/fu94fe98","slideIndex":0,"position":{"left":98,"top":320,"width":506,"height":80},"name":"customer-body","text":"Health plan CSRs navigate complex plan data during live calls. Manual lookup increases handling time and the risk of inconsistent benefit explanations.","geometry":"rect","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"}}
{"kind":"textbox","id":"sh/utg3698n","slideIndex":0,"position":{"left":674,"top":286,"width":506,"height":28},"name":"solution-heading","text":"The solution","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/wn6dc7eh","slideIndex":0,"position":{"left":674,"top":320,"width":506,"height":80},"name":"solution-body","text":"Ask in plain language. CSR Chat returns coverage, cost sharing, limits and required disclosures from approved plan data for representative review.","geometry":"rect","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"}}
{"kind":"textbox","id":"sh/hofulsf2","slideIndex":0,"position":{"left":98,"top":416,"width":506,"height":28},"name":"value-heading","text":"The value proposition","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/ul4vaxgb","slideIndex":0,"position":{"left":98,"top":450,"width":506,"height":80},"name":"value-body","text":"BSC, Sep 2026: 11 sec median answer time.\n32,114 interactions. 1,336 monthly active users.\nGoal: less manual benefit research during calls.","geometry":"rect","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"}}
{"kind":"textbox","id":"sh/5sfepcfe","slideIndex":0,"position":{"left":98,"top":554,"width":1080,"height":28},"name":"offer-heading","text":"The offer and next step","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/ipovexwn","slideIndex":0,"position":{"left":98,"top":588,"width":1080,"height":60},"name":"offer-body","text":"Core in production at BSC. Standalone non-PHI pilots in pipeline. Next: Expand LOB and knowledge capabilities to serve the members wholly. Targets: ≥95% approved-case pass rate and launch 2 new pilot customers early in 2027.","geometry":"rect","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"}}
{"kind":"textbox","id":"sh/3qxwn2x8","slideIndex":0,"position":{"left":674,"top":418.77,"width":506,"height":28},"name":"solution-heading","text":"Competitors","geometry":"rect","lineWidth":0,"style":{"fontSize":21.33,"typeface":"Geist","color":"#1D224B","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/sfqdkrep","slideIndex":0,"position":{"left":674,"top":452.77,"width":506,"height":80},"name":"solution-body","text":"NiCE CXone Copilot and Genesys Agent Copilot.\nCSR Chat focus: health plan benefit interpretation,\napproved disclosures and representative review.","geometry":"rect","lineWidth":0,"style":{"fontSize":18.67,"typeface":"Geist Light","color":"#000000","alignment":"left"}}